{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scp-study",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"]
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "scp-study-audio"
    }
  ]
}
